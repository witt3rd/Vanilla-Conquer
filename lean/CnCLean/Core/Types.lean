/-- Convert unsigned byte to signed 8-bit integer (-128 .. 127) -/
def toSigned8 (v : UInt8) : Int :=
  let n : Int := v.toNat
  if n >= 128 then n - 256 else n

/-- Arithmetic right shift by 7 matching C++ `>> 7` on signed integers -/
def shr7 (v : Int) : Int :=
  Int.fdiv v 128

/-- Westwood `calcx(signed char param, short distance)` -/
def calcx (param : UInt8) (distance : Int) : Int :=
  shr7 (toSigned8 param * distance)

/-- Westwood `calcy(signed char param, short distance)` -/
def calcy (param : UInt8) (distance : Int) : Int :=
  -(shr7 (toSigned8 param * distance))

/-- Pack (cx, cy, lx, ly) into 32-bit COORDINATE -/
def makeCoord (cx cy lx ly : UInt32) : Coordinate :=
  (((ly &&& (0xFF : UInt32)) <<< 16) ||| ((cy &&& (0x3F : UInt32)) <<< 24) ||| (lx &&& (0xFF : UInt32)) ||| ((cx &&& (0x3F : UInt32)) <<< 8))

/-- Unpack 32-bit COORDINATE into (cx, cy, lx, ly) -/
def coordComponents (coord : Coordinate) : (UInt32 × UInt32 × UInt32 × UInt32) :=
  let lx : UInt32 := coord &&& (0xFF : UInt32)
  let cx : UInt32 := (coord >>> 8) &&& (0x3F : UInt32)
  let ly : UInt32 := (coord >>> 16) &&& (0xFF : UInt32)
  let cy : UInt32 := (coord >>> 24) &&& (0x3F : UInt32)
  (cx, cy, lx, ly)

/-- Convert (cx, cy) cell coordinates to 1D cell index (0 .. 4095) -/
def cellIndex (cx cy : UInt32) : UInt32 :=
  (cx &&& (0x3F : UInt32)) + ((cy &&& (0x3F : UInt32)) <<< 6)

/-- Unpack 1D cell index into (cx, cy) -/
def cellFromIndex (index : UInt32) : (UInt32 × UInt32) :=
  (index &&& (0x3F : UInt32), (index >>> 6) &&& (0x3F : UInt32))

/-- Centered coordinate (128, 128 leptons) for a given cell index -/
def cellCoord (cell : UInt32) : Coordinate :=
  let (cx, cy) := cellFromIndex cell
  makeCoord cx cy 128 128

/-- Advance 32-bit packed COORDINATE by `distance` in direction `dirFacing` -/
def coordMove (startCoord : Coordinate) (dirFacing : DirType) (distance : Int) : Coordinate :=
  let x : Int := (startCoord &&& 0xFFFF).toNat
  let y : Int := ((startCoord >>> 16) &&& 0xFFFF).toNat
  let idx := dirFacing.toNat % 256
  let cosVal := COS_TABLE.getD idx 0
  let sinVal := SIN_TABLE.getD idx 0
  let nx : UInt32 := UInt32.ofNat (Int.toNat ((x + calcx cosVal distance) % 65536))
  let ny : UInt32 := UInt32.ofNat (Int.toNat ((y + calcy sinVal distance) % 65536))
  ((ny &&& 0xFFFF) <<< 16) ||| (nx &&& 0xFFFF)

/-- Convert 256-step DirType to 8-step FacingType -/
def dirToFacing8 (dirVal : DirType) : FacingType :=
  (dirVal + 16) >>> 5

/-- Convert 8-step FacingType to 256-step DirType -/
def facing8ToDir (facing : FacingType) : DirType :=
  (facing &&& 7) <<< 5

/-- Shortest signed angular difference in 256-unit circle: int8(desired - current) -/
def facingDifference (desired current : DirType) : Int :=
  toSigned8 (desired - current)

/-- Non-negative shortest angular distance in [0, 128] -/
def angularDistance (a b : DirType) : Nat :=
  (facingDifference b a).natAbs

/-- Adjust current facing toward desired facing by clamped rate -/
def rotationAdjust (current desired rate : DirType) : DirType :=
  let clampedRate : DirType := rate &&& 0x7F
  let diff : Int := facingDifference desired current
  if diff.natAbs <= clampedRate.toNat then
    desired
  else if diff > 0 then
    current + clampedRate
  else if diff == -128 then
    current - clampedRate
  else
    current - clampedRate

end CnCLean.Core
